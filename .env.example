# Copie este arquivo para .env e substitua todos os valores marcados.
# Nunca versione o arquivo .env.

NODE_ENV=production
APP_URL=https://trips.example.com
APP_PORT=3050

DB_USER=trips
DB_PASSWORD=change_to_a_long_unique_password
DB_NAME=trips

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_to_a_long_unique_password
ADMIN_NAME=Administrator
SESSION_SECRET=generate_a_long_random_session_secret

SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
MAIL_FROM="Trips <noreply@example.com>"

TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PEXELS_API_KEY=

UPLOAD_PATH=/data/uploads
MAX_UPLOAD_SIZE_MB=25
SEED_DEMO=false
