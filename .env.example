# Copie este arquivo para .env e substitua todos os valores marcados.
# Nunca versione o arquivo .env.

NODE_ENV=production
APP_URL=https://trips.example.com
APP_PORT=3050

DB_USER=trips
DB_PASSWORD=change_to_a_long_unique_password
DB_NAME=trips

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_to_a_long_unique_password
ADMIN_NAME=Administrator
SESSION_SECRET=generate_a_long_random_session_secret

SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
MAIL_FROM="Trips <noreply@example.com>"

TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Modelo com suporte à Responses API e web_search para localizar as paradas do roteiro.
OPENAI_MAP_MODEL=gpt-5.6-luna
PEXELS_API_KEY=

UPLOAD_PATH=/data/uploads
MAX_UPLOAD_SIZE_MB=25
# All uploads are processed by AI, so this lower limit is enforced regardless
# of MAX_UPLOAD_SIZE_MB. Defaults below match the guarded production baseline.
AI_MAX_DOCUMENT_SIZE_MB=10
AI_MAX_DOCUMENT_PAGES=20
AI_MAX_INPUT_CHARS=100000
AI_DAILY_TOKENS_PER_USER=50000
AI_DAILY_TOKENS_PER_TRIP=100000
AI_MONTHLY_TOKENS_PER_USER=500000
AI_MONTHLY_TOKENS_PER_TRIP=1000000
AI_MAX_CONCURRENT_REQUESTS=2
AI_QUEUE_TIMEOUT_MS=15000

# Inbound email stores a reviewable draft by default. Set true only after a
# deliberate risk review; it allows automatic trip/entity mutations.
INBOUND_AUTO_CONFIRM=false
SEED_DEMO=false
